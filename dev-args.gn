# Fast iteration build. NOT for verification.
#
# Measured on this machine, changing one .cc file:
#   out/Release-pgo (official + PGO + thin-LTO): 53 s   (~48 s of it is the link)
#   out/Dev (component, no PGO, no LTO):         ~5-8 s expected, link is ~1-3 s
# A content/public header change:
#   out/Release-pgo: 8-45 min (2000-2700 translation units re-run through LTO)
#   out/Dev:         2-4 min  (same recompile, no LTO)
#
# Why it must stay a second directory: `is_official_build` and PGO change runtime
# behaviour (UA/branding strings, code layout, some timing), so the fingerprint
# gates and every acceptance claim must be measured on out/Release-pgo. This build
# exists only to answer "does it compile and does the button work".
#
# One-time cost: a cold full build of this tree on 8C/16T is 3-4 hours, and the
# directory is ~35 GB. E: has >800 GB free.
#
#   cd E:\chromium\src
#   gn gen out\Dev --args="import(\"//E:/FingerprintBrowser/dev-args.gn\")"
#   autoninja -C out\Dev chrome
#
# (Simpler: paste the block below into out\Dev\args.gn with `gn gen out\Dev`.)

is_debug = false
is_component_build = true
is_official_build = false
symbol_level = 1
blink_symbol_level = 0
enable_resource_allowlist_generation = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
use_remoteexec = false
is_pgo = false
