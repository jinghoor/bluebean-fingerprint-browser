+  // 关掉整个窗口，就什么也观察不到了。真实的切换流程也不会出现空 strip。
+  for (int i = total - 1; i >= 1; --i) {
+    std::unique_ptr<content::WebContents> wc =
+        model->DetachWebContentsAtForInsertion(i);
+    if (wc) {
+      probe_detached_contents_.push_back(std::move(wc));
+      ++detached;
+    }
