+void Browser::DetachAllTabsForProbe() {
+  TabStripModel* model = tab_strip_model();
+  if (!model) {
+    LOG(ERROR) << "DETACHPROBE: no tab strip model";
+    return;
+  }
+  const int total = model->count();
