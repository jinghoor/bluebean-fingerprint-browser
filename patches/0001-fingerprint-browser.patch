     cert_verifier::mojom::CertVerifierCreationParams*
         cert_verifier_creation_params) {
@@ -7257,6 +7289,92 @@ void ChromeContentBrowserClient::ConfigureNetworkContextParams(
     network_context_params->user_agent = GetUserAgent();
     network_context_params->accept_language = GetApplicationLocale();
   }
+
+  // Per-environment proxy. This function is the one place where a partition's
+  // path is known alongside its NetworkContextParams, so it is where a partition
+  // can be pointed at its own exit while the rest of the browser keeps the
+  // system/default proxy. Runs after the service so it overrides the profile
+  // level setting for this partition only.
+  if (!partition_config.is_default()) {
+    Profile* profile = Profile::FromBrowserContext(context);
+    if (auto* manager = profile ? env::EnvManager::GetForProfile(profile)
+                                : nullptr) {
+      const std::string rules =
+          manager->ProxyRulesForPartition(partition_config);
+      if (!rules.empty() && rules != "system") {
+        if (rules == "direct") {
+          network_context_params->initial_proxy_config =
+              net::ProxyConfigWithAnnotation::CreateDirect();
+        } else {
+          net::ProxyConfig::ProxyRules proxy_rules;
+          proxy_rules.ParseFromString(rules);
+          net::ProxyConfig config;
+          config.proxy_rules() = proxy_rules;
+          network_context_params->initial_proxy_config =
+              net::ProxyConfigWithAnnotation(config,
+                                             MISSING_TRAFFIC_ANNOTATION);
+        }
+        LOG(ERROR) << "ENVPROXY: partition="
+                   << partition_config.partition_name() << " rules=" << rules;
+      }
+
+      // Per-environment Accept-Language. The profile default is the browser's UI
+      // language, so a US exit was sending zh-CN and Google answered in Chinese --
+      // measured on https://www.google.com/search?q=ai: Chinese UI, IP 212.60.14.245.
+      const std::string languages =
+          manager->AcceptLanguagesForPartition(partition_config);
+      if (!languages.empty()) {
+        network_context_params->accept_language =
+            net::HttpUtil::GenerateAcceptLanguageHeader(languages);
+        LOG(ERROR) << "ENVLANG: partition=" << partition_config.partition_name()
+                   << " accept_language=" << languages;
+      }
+    }
+  }
+}
+
+std::string ChromeContentBrowserClient::GetLocaleForPartition(
+    content::BrowserContext* browser_context,
+    const content::StoragePartitionConfig& partition_config) {
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (!profile || partition_config.is_default()) {
+    return std::string();
+  }
+  auto* manager = env::EnvManager::GetForProfile(profile);
+  return manager ? manager->LocaleForPartition(partition_config) : std::string();
+}
+
+std::string ChromeContentBrowserClient::GetFingerprintSeedForPartition(
+    content::BrowserContext* browser_context,
+    const content::StoragePartitionConfig& partition_config) {
+  // Same lookup the proxy uses: the partition name is the environment's
+  // identity. Environments carry their own seed so that a seed whose derived
+  // timezone matches the proxy's exit can be chosen when the environment is
+  // created; without one the manager derives a stable seed from the id.
+  if (partition_config.is_default()) {
+    return std::string();
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (!profile) {
+    return std::string();
+  }
+  auto* manager = env::EnvManager::GetForProfile(profile);
+  return manager ? manager->SeedForPartition(partition_config) : std::string();
+}
+
+std::string ChromeContentBrowserClient::GetFingerprintLanguagesForPartition(
+    content::BrowserContext* browser_context,
+    const content::StoragePartitionConfig& partition_config) {
+  if (partition_config.is_default()) {
+    return std::string();
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  if (!profile) {
+    return std::string();
+  }
+  auto* manager = env::EnvManager::GetForProfile(profile);
+  return manager ? manager->FingerprintLanguagesForPartition(partition_config)
+                 : std::string();
 }
 
